{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ]
}